# Copiar a scraper/.env y completar.

# Credenciales de la API de MercadoLibre (solo las usa auth.js)
# 1. Crear una app en https://developers.mercadolibre.com/
# 2. Copiar el Client ID y el Client Secret acá abajo
# 3. Correr `node auth.js` desde scraper/: obtiene un token con client_credentials
#    y completa MELI_ACCESS_TOKEN y MELI_TOKEN_EXPIRES_AT en este archivo
MELI_CLIENT_ID=your_client_id_here
MELI_CLIENT_SECRET=your_client_secret_here

# Los completa auth.js automáticamente; no editar a mano
MELI_ACCESS_TOKEN=
MELI_TOKEN_EXPIRES_AT=

# Proxies para el CLI (opcional). Ver .env.example en la raíz para el formato.
MELI_PROXIES=
