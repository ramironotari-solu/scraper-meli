# Copiar a .env.local y completar. Next.js lo carga al levantar la web,
# y los scrapers que lanza la API heredan estas variables.

# Resumen de mercado con IA (opcional: sin clave la web funciona, pero sin el resumen)
ANTHROPIC_API_KEY=

# Proxies para los scrapers (opcional). Lista separada por comas, formatos:
#   http://host:port  ·  http://user:pass@host:port  ·  socks5://host:port
# Alternativa: un proxy por línea en scraper/proxies.txt (no se versiona).
MELI_PROXIES=
